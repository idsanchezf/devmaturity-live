# Copiar a .env.local (nunca commitear .env.local)
# Ambas son seguras de exponer en el cliente: la Anon Key SOLO abre PostgREST,
# la autorización real vive en RLS + auth.uid() (ver supabase/schema.sql).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# Passphrase ligera para evitar que cualquiera con el link abra el panel de
# moderador. NO es un control de seguridad fuerte (vive en el bundle público),
# solo disuade accesos casuales. La seguridad real de "quién puede mutar qué"
# sigue viviendo en RLS (moderator_user_id = auth.uid()).
VITE_MODERATOR_PASSPHRASE=cambia-esto

# Opcional: fuerza el base path de Vite (por defecto /devmaturity-live/)
# VITE_BASE_PATH=/devmaturity-live/
